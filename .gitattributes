* text=auto
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.yaml text eol=lf
*.ps1 text eol=crlf

# Exact executed bytes are part of the frozen Experiment 0 fingerprints.
src/video_compute_value/*.py -text
configs/e000_threaded_authorized_v3.yaml -text

# Preserve E1 public CSV hashes on Windows checkouts.
.gitattributes text eol=lf
results/e001_20261029_132707_v1/*.csv text eol=lf

# Keep sanitized timing-follow-up CSV bytes stable across Windows staging.
results/e000_20261029_150300_timing_stabilization_v5/*.csv text eol=lf

# Keep the E2 checkpoint's data and rendered SVG hashes stable on Windows.
results/e002_20261029_073134_v1/*.csv text eol=lf
results/e002_20261029_073134_v1/figures/*.svg text eol=lf

# Preserve the continuation's public table and figure hashes on Windows.
.gitignore text eol=lf
results/e002_*_continuation_v2/*.csv text eol=lf
results/e002_*_continuation_v2/figures/*.svg text eol=lf
